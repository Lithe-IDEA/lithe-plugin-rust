{
  "schemaVersion": 0,
  "id": "io.github.lithe-idea.rust-support",
  "displayName": "Rust Support",
  "version": "0.1.0",
  "pluginAPIVersion": 0,
  "requires": {
    "backend": 0,
    "buildProviders": 1,
    "buildSystems": 0,
    "commandInstallers": 1,
    "debugAdapters": 0,
    "languageServers": 0,
    "languages": 0,
    "projectGenerators": 0,
    "settings": 0,
    "toolDefinitions": 1
  },
  "requiresTools": [
    "cargo",
    "rust-analyzer",
    "rustup"
  ],
  "vendor": {
    "id": "io.github.lithe-idea",
    "displayName": "Lithe Community",
    "signatureRequirement": "none"
  },
  "permissions": [
    "backend.launch",
    "commands.install",
    "debug.launch",
    "languageServer.launch",
    "process.build",
    "project.generate",
    "workspace.metadata"
  ],
  "activationEvents": [
    "onBuildSystem:cargo",
    "onDebug:codelldb",
    "onLanguage:rust"
  ],
  "settings": [
    {
      "id": "checkOnSave",
      "type": "boolean",
      "title": "Check on save",
      "description": "Run Cargo's check each time a Rust file is saved and show what it finds as diagnostics.",
      "default": true,
      "effect": "immediate",
      "page": {
        "languageID": "rust"
      },
      "section": "rust-analyzer"
    },
    {
      "id": "checkCommand",
      "type": "enum",
      "title": "Check command",
      "description": "The Cargo command the check on save runs. Clippy adds its lints and takes longer.",
      "default": "check",
      "effect": "immediate",
      "page": {
        "languageID": "rust"
      },
      "section": "rust-analyzer",
      "options": [
        {
          "value": "check",
          "title": "cargo check"
        },
        {
          "value": "clippy",
          "title": "cargo clippy"
        }
      ]
    },
    {
      "id": "installRustAnalyzer",
      "type": "boolean",
      "title": "Install rust-analyzer with rustup",
      "description": "When the project's rustup toolchain lacks rust-analyzer, add it and rust-src with rustup component add before starting it.",
      "default": true,
      "page": {
        "languageID": "rust"
      },
      "section": "rust-analyzer"
    }
  ],
  "languages": [
    {
      "id": "rust",
      "displayName": "Rust",
      "fileExtensions": [
        "rs"
      ],
      "projectFileNames": [
        "Cargo.toml"
      ],
      "dependencies": {
        "managementFileNames": [
          "Cargo.toml",
          "Cargo.lock"
        ]
      }
    }
  ],
  "languageServers": [
    {
      "languageID": "rust",
      "languageIdentifier": "rust",
      "launch": {
        "kind": "backend",
        "function": "rustAnalyzer.launch",
        "timeoutMilliseconds": 120000
      },
      "workspaceConfiguration": {
        "rust-analyzer": {
          "checkOnSave": "${setting:checkOnSave}",
          "check": {
            "command": "${setting:checkCommand}"
          }
        }
      }
    }
  ],
  "buildSystems": [
    {
      "id": "cargo",
      "displayName": "Cargo",
      "detection": {
        "markers": [
          "Cargo.toml"
        ],
        "nesting": "outermost",
        "priority": 60
      },
      "invocation": {
        "executables": [
          {
            "id": "toolchain",
            "kind": "toolchain",
            "toolchainID": "cargo"
          }
        ]
      },
      "provider": {
        "launch": {
          "kind": "packaged",
          "path": "bin/backend"
        },
        "executesProjectCode": true,
        "mayUseNetwork": true
      },
      "options": [
        {
          "id": "release",
          "displayName": "Release Profile",
          "kind": "boolean",
          "description": "Build with the release profile: optimized, without debug assertions. Programs go to target/release.",
          "arguments": [
            "--release"
          ]
        },
        {
          "id": "features",
          "displayName": "Features",
          "kind": "multiSelect",
          "choicesFromModel": true,
          "presentation": "tree",
          "description": "Features to turn on, listed for each package. A command passes only the features of the packages it builds.",
          "arguments": [
            "--features",
            "${value}"
          ]
        },
        {
          "id": "allFeatures",
          "displayName": "All Features",
          "kind": "boolean",
          "description": "Turn on every feature of the packages a command builds. Overrides the features chosen above.",
          "arguments": [
            "--all-features"
          ]
        },
        {
          "id": "noDefaultFeatures",
          "displayName": "No Default Features",
          "kind": "boolean",
          "description": "Leave out each package's default features; only the chosen features are on.",
          "arguments": [
            "--no-default-features"
          ]
        },
        {
          "id": "offline",
          "displayName": "Offline",
          "kind": "boolean",
          "description": "Build without the network, from what Cargo has already downloaded.",
          "arguments": [
            "--offline"
          ]
        }
      ],
      "model": {
        "source": "provider"
      },
      "tasks": [
        {
          "id": "build",
          "displayName": "Build",
          "group": "build",
          "scopes": [
            "workspace",
            "project",
            "target"
          ],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "check",
          "displayName": "Check",
          "group": "verification",
          "scopes": [
            "workspace",
            "project",
            "target"
          ],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "clippy",
          "displayName": "Clippy",
          "group": "verification",
          "scopes": [
            "workspace",
            "project",
            "target"
          ],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "doc",
          "displayName": "Doc",
          "group": "documentation",
          "scopes": [
            "workspace",
            "project"
          ],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "clean",
          "displayName": "Clean",
          "group": "build",
          "scopes": [
            "workspace",
            "project"
          ],
          "source": "provider",
          "arguments": []
        }
      ],
      "run": [
        {
          "id": "application",
          "source": "provider",
          "fromTargets": {
            "tags": [
              "application"
            ]
          },
          "debug": {
            "adapter": "codelldb"
          }
        },
        {
          "id": "example",
          "source": "provider",
          "fromTargets": {
            "tags": [
              "example"
            ]
          },
          "debug": {
            "adapter": "codelldb"
          }
        },
        {
          "id": "rust-main",
          "source": "provider",
          "name": "Cargo Run",
          "entrypoints": true
        }
      ],
      "diagnostics": {
        "decoder": "lineMatcher",
        "patterns": [
          {
            "regex": "^([^\\s:][^:]*\\.rs):(\\d+):(\\d+): (error|warning)(?:\\[[\\w:]+\\])?: (.+)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        ]
      },
      "dependencies": {
        "source": "provider",
        "scopes": [
          "workspace",
          "project"
        ]
      },
      "sync": {
        "watch": [
          "Cargo.toml",
          "Cargo.lock",
          ".cargo/config",
          ".cargo/config.toml",
          "rust-toolchain",
          "rust-toolchain.toml"
        ]
      },
      "layout": {
        "excluded": [
          "target"
        ]
      }
    }
  ],
  "debugAdapters": [
    {
      "id": "codelldb",
      "displayName": "Rust (CodeLLDB)",
      "adapterID": "lldb",
      "requests": [
        "launch"
      ],
      "selectors": [
        {
          "targetKinds": [
            "executable"
          ]
        }
      ],
      "configurationTypes": [
        "lldb"
      ],
      "configurations": {
        "launch": {
          "arguments": {
            "sourceLanguages": [
              "rust"
            ],
            "terminal": "console"
          },
          "targetBindings": {
            "program": "target.path",
            "cwd": "target.workingDirectory",
            "args": "target.arguments",
            "env": "target.environment"
          }
        }
      },
      "launch": {
        "process": {
          "launch": {
            "kind": "systemCommand",
            "commands": [
              "codelldb"
            ]
          }
        },
        "transport": "stdio"
      }
    }
  ],
