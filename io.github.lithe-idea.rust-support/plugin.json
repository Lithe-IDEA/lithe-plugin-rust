  "projectGenerators": [
    {
      "id": "cargo-package",
      "displayName": "Rust",
      "description": "A Rust package built with Cargo.",
      "section": "project",
      "order": 40,
      "icon": {
        "path": "icons/rust.svg",
        "darkPath": "icons/rust-dark.svg",
        "mode": "original"
      },
      "fields": [
        {
          "id": "cargo",
          "type": "tool",
          "title": "Cargo",
          "description": "The Cargo the project builds and runs with. The project keeps this choice.",
          "tool": "cargo",
          "pinAs": "project",
          "optional": true
        },
        {
          "id": "crateKind",
          "type": "enum",
          "title": "Crate",
          "default": "binary",
          "presentation": "segmented",
          "options": [
            {
              "value": "binary",
              "title": "Binary"
            },
            {
              "value": "library",
              "title": "Library"
            }
          ]
        },
        {
          "id": "packageName",
          "type": "text",
          "title": "Package name",
          "description": "The name line of Cargo.toml: what other packages depend on and what the program is called.",
          "default": "${project.name|lower}",
          "pattern": "[A-Za-z][A-Za-z0-9_-]*",
          "maxLength": 64
        },
        {
          "id": "edition",
          "type": "enum",
          "title": "Edition",
          "advanced": true,
          "description": "The Rust edition the package is written in. Edition 2024 needs Rust 1.85 or newer.",
          "default": "2024",
          "options": [
            {
              "value": "2024",
              "title": "2024"
            },
            {
              "value": "2021",
              "title": "2021"
            }
          ]
        }
      ],
      "requirements": [
        {
          "languageID": "rust"
        },
        {
          "buildSystemID": "cargo"
        }
      ],
      "steps": [
        {
          "kind": "files",
          "source": "templates/rust/package"
        },
        {
          "kind": "files",
          "source": "templates/rust/binary",
          "when": {
            "field": "crateKind",
            "equals": "binary"
          }
        },
        {
          "kind": "files",
          "source": "templates/rust/library",
          "when": {
            "field": "crateKind",
            "equals": "library"
          }
        }
      ],
      "openFiles": [
        {
          "path": "src/main.rs",
          "when": {
            "field": "crateKind",
            "equals": "binary"
          }
        },
        {
          "path": "src/lib.rs",
          "when": {
            "field": "crateKind",
            "equals": "library"
          }
        }
      ]
    }
  ],
  "commandInstallers": [
